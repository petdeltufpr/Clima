// FUNCAO PRINCIPAL

function doGet(e) {

  // Receber os dados enviados pelo ESP32
  var dados = {
    temperatura: Number(e.parameter.temperatura),
    umidade: Number(e.parameter.umidade),
    pressao: Number(e.parameter.pressao),
    ppm: Number(e.parameter.ppm),
    altitude: Number(e.parameter.altitude),
    orvalho: Number(e.parameter.orvalho)
  };

  // Validar os dados
  var valores = [
    dados.temperatura,
    dados.umidade,
    dados.pressao,
    dados.ppm,
    dados.altitude,
    dados.orvalho
  ];

  if (!valores.every(Number.isFinite)) {
    return ContentService.createTextOutput(
      "Erro: dados recebidos invalidos"
    );
  }

  // Salvar no Google Sheets
  try {
    var planilha = SpreadsheetApp
      .getActiveSpreadsheet()
      .getActiveSheet();

    planilha.appendRow([
      new Date(),
      dados.temperatura,
      dados.umidade,
      dados.pressao,
      dados.ppm,
      dados.altitude,
      dados.orvalho
    ]);

  } catch (erro) {
    return ContentService.createTextOutput(
      "Erro ao salvar no Google Sheets: " + String(erro)
    );
  }

  // Enviar os dados para Adafruit IO
  var resultado = enviarAdafruit(dados);

  // Retornar o resultado
  if (!resultado.sucesso) {
    return ContentService.createTextOutput(
      "Google Sheets atualizado, mas houve erro no Adafruit IO.\n" +
      "Codigo HTTP: " + resultado.codigo + "\n" +
      "Resposta: " + resultado.resposta
    );
  }

  return ContentService.createTextOutput(
    "Sucesso! Google Sheets e Adafruit IO atualizados."
  );
}

// FUNCAO DE ENVIO PARA ADAFRUIT IO

function enviarAdafruit(dados) {

  var propriedades = PropertiesService.getScriptProperties();

  var usuario = propriedades.getProperty("AIO_USERNAME");
  var chave = propriedades.getProperty("AIO_KEY");

  var grupo = "estacao-climatica";

  if (!usuario || !chave) {
    return {
      sucesso: false,
      codigo: "CONFIG",
      resposta: "AIO_USERNAME ou AIO_KEY nao configurados."
    };
  }

  var url =
    "https://io.adafruit.com/api/v2/" +
    usuario +
    "/groups/" +
    grupo +
    "/data";

  var payload = {
    feeds: [
      { key: "temperatura", value: String(dados.temperatura) },
      { key: "umidade", value: String(dados.umidade) },
      { key: "pressao", value: String(dados.pressao) },
      { key: "gases", value: String(dados.ppm) },
      { key: "altitude", value: String(dados.altitude) },
      { key: "ponto-de-orvalho", value: String(dados.orvalho) }
    ]
  };

  try {
    var resposta = UrlFetchApp.fetch(url, {
      method: "post",
      contentType: "application/json",
      headers: {
        "X-AIO-Key": chave
      },
      payload: JSON.stringify(payload),
      muteHttpExceptions: true
    });

    var codigo = resposta.getResponseCode();
    var texto = resposta.getContentText();

    console.log("Codigo HTTP: " + codigo);
    console.log("Resposta Adafruit: " + texto);

    return {
      sucesso: codigo >= 200 && codigo < 300,
      codigo: codigo,
      resposta: texto
    };

  } catch (erro) {
    console.error("Erro na comunicacao: " + String(erro));

    return {
      sucesso: false,
      codigo: "EXCECAO",
      resposta: String(erro)
    };
  }
}

